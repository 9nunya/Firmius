import { Theme } from "../foundation/theme.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
export component FileReference inherits Button {
    in property <string> path;
    in property <int> location: 0;
    in property <string> action-label: "Open recorded evidence for";
    label: root.location <= 0 ? root.path : root.path + ":" + root.location;
    intent: ButtonIntent.quiet;
    accessible-label: action-label + " " + self.label;
}
