import { Theme } from "../foundation/theme.slint";
import { CodeLine } from "../models.slint";
import { ListView } from "std-widgets.slint";
export component CodeLines inherits Rectangle {
    in property <[CodeLine]> lines;
    in property <bool> diff: false;
    min-height: min(216px, max(26px, lines.length * 20px * Theme.text-scale));
    preferred-height: self.min-height;
    background: Theme.window;
    ListView {
        viewport-width: max(self.visible-width, 960px * Theme.text-scale);
        for line in root.lines: Rectangle {
            height: max(20px * Theme.text-scale, text.preferred-height + 4px);
            background: line.kind == "addition" ? Theme.diff-add-bg : (line.kind == "deletion" ? Theme.diff-remove-bg : transparent);
            HorizontalLayout {
                padding-left: 6px; padding-right: 6px; spacing: 8px;
                Text { text: line.new-number == "" ? line.old-number : line.new-number; min-width: 28px; color: Theme.secondary; font-family: "monospace"; font-size: Theme.code-size; horizontal-alignment: right; }
                if root.diff: Text {
                    text: line.kind == "addition" ? "+" : (line.kind == "deletion" ? "−" : " ");
                    min-width: 12px;
                    color: line.kind == "addition" ? Theme.diff-add-text : (line.kind == "deletion" ? Theme.diff-remove-text : Theme.secondary);
                    font-family: "monospace"; font-size: Theme.code-size;
                }
                text := TextInput {
                    text: line.text; read-only: true; single-line: true;
                    color: line.kind == "hunk" ? Theme.secondary : (line.kind == "addition" ? Theme.diff-add-text : (line.kind == "deletion" ? Theme.diff-remove-text : Theme.text));
                    font-family: "monospace"; font-size: Theme.code-size; horizontal-stretch: 1;
                }
            }
        }
    }
}
