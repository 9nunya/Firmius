import { Theme } from "../foundation/theme.slint";
import { ScrollView } from "std-widgets.slint";
// A bounded selectable output surface. Scrolling never expands a transcript row.
export component OutputViewer inherits Rectangle {
    in property <string> text;
    in property <bool> preserve-columns: true;
    min-height: min(160px, max(28px, output.preferred-height + 16px));
    preferred-height: min(160px, max(28px, output.preferred-height + 16px));
    background: Theme.window;
    border-radius: Theme.radius;
    ScrollView {
        x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
        viewport-width: root.preserve-columns ? max(self.visible-width, output.preferred-width) : self.visible-width;
        viewport-height: output.preferred-height;
        output := TextInput {
            text: root.text; read-only: true; single-line: false; wrap: root.preserve-columns ? no-wrap : word-wrap;
            width: root.preserve-columns ? max(parent.width, self.preferred-width) : parent.width; height: self.preferred-height;
            font-family: "monospace"; font-size: Theme.secondary-size;
            color: Theme.text;
            selection-background-color: Theme.selected;
            selection-foreground-color: Theme.text;
        }
    }
}