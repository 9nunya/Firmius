import { Theme } from "../foundation/theme.slint";
import { TerminalLine } from "../models.slint";
import { ScrollView } from "std-widgets.slint";
export component TerminalPreview inherits Rectangle {
    in property <[TerminalLine]> lines;
    in property <int> max-lines: 9;
    height: min(max-lines * 16px + 16px, max(32px, lines.length * 16px + 16px));
    background: Theme.window; border-radius: Theme.radius;
    ScrollView {
        x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
        viewport-width: content.preferred-width;
        viewport-height: content.preferred-height;
        changed viewport-height => { self.viewport-y = min(0px, self.visible-height - self.viewport-height); }
        content := VerticalLayout {
            alignment: start; spacing: 0px;
            for line in root.lines: HorizontalLayout {
                height: 16px; spacing: 0px; alignment: start;
                for span in line.spans: Text {
                    text: span.text; color: span.ink; font-weight: span.strong ? 700 : 400;
                    font-family: "monospace"; font-size: Theme.secondary-size;
                    horizontal-stretch: 0;
                }
            }
        }
    }
}
