import { Theme } from "../foundation/theme.slint";
import { WorkGraphRow } from "../models.slint";
import { WorkView } from "../views/work.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { ToolIcon } from "../kit/tool-icon.slint";
export component WorkflowFloat inherits Rectangle {
    in property <[WorkGraphRow]> graphs;
    in property <length> available-width: 440px;
    in property <length> available-height: 380px;
    in property <bool> expanded: false;
    callback toggled;
    width: self.expanded ? max(0px, min(440px, root.available-width - Theme.space-8)) : Theme.control-height;
    height: self.expanded ? max(0px, min(380px, root.available-height - 160px)) : Theme.control-height;
    background: Theme.raised;
    border-width: 1px; border-color: Theme.border; border-radius: 8px;
    clip: true;
    animate width, height { duration: Theme.motion-disclosure; easing: ease-out; }
    VerticalLayout {
        spacing: 0px;
        Button {
            label: root.expanded ? "Workflow  ×" : "";
            accessible-label: "Workflow";
            caption-alignment: left;
            intent: ButtonIntent.quiet;
            horizontal-stretch: 1;
            activated => { root.toggled(); }
            if !root.expanded: ToolIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                kind: "workflow";
            }
        }
        if root.expanded: WorkView { graphs: root.graphs; compact: true; }
    }
}