import { Theme } from "../foundation/theme.slint";
import { ModelOption } from "../models.slint";
import { LineEdit } from "../kit/fields.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { ScrollView } from "std-widgets.slint";
export component ModelMenu inherits Rectangle {
    in property <[ModelOption]> options;
    in-out property <string> query;
    callback search(string);
    callback selected(string, string);
    forward-focus: query-field;
    background: Theme.bg-surface-raised;
    border-width: 1px; border-color: Theme.border-subtle; border-radius: Theme.radius-md;
    VerticalLayout {
        padding: Theme.space-2; spacing: Theme.space-2;
        query-field := LineEdit { text <=> root.query; placeholder-text: "Search models…"; edited(text) => { root.search(text); } }
        ScrollView {
            VerticalLayout {
                alignment: start; spacing: Theme.space-1;
                for model[index] in root.options: VerticalLayout {
                    if index == 0 || root.options[index - 1].provider != model.provider: Text {
                        height: Theme.data-row-height; text: model.provider; color: Theme.text-secondary;
                        font-size: Theme.caption-size; vertical-alignment: center;
                    }
                    Button {
                        label: model.model;
                        elide: true;
                        intent: ButtonIntent.quiet;
                        activated => { root.selected(model.provider, model.model); }
                    }
                    if model.detail != "": Text {
                        text: model.detail; color: Theme.text-secondary; font-size: Theme.caption-size; overflow: elide;
                    }
                }
                if root.options.length == 0: Text { text: "No matching models"; color: Theme.text-secondary; }
            }
        }
    }
}
