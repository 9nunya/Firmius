import { Theme } from "../foundation/theme.slint";
import { WorkGraphRow } from "../models.slint";
import { WorkView } from "../views/work.slint";
import { Button, ButtonIntent } from "../kit/button.slint";

// The focused agent's durable todo ledger. It stays attached to the session
// surface and can be tucked away without changing the transcript layout.
export component TodoFloat inherits Rectangle {
    in property <[WorkGraphRow]> graphs;
    in property <length> available-width: 420px;
    in property <length> available-height: 320px;
    in-out property <bool> expanded: false;
    callback toggled;
    width: root.expanded ? max(0px, min(360px, root.available-width - Theme.space-8)) : 108px;
    height: root.expanded ? max(0px, min(300px, root.available-height - 152px)) : Theme.control-height;
    background: Theme.raised;
    border-width: 1px; border-color: Theme.border; border-radius: 9px;
    clip: true;
    animate width { duration: Theme.motion-disclosure; easing: ease-out; }
    animate height { duration: Theme.motion-disclosure; easing: ease-out; }
    VerticalLayout {
        spacing: 0px;
        Button {
            label: root.expanded ? "Todos  ×" : (root.graphs.length > 0 ? "Todos  · " + root.graphs[0].completed + "/" + root.graphs[0].nodes.length : "Todos");
            intent: ButtonIntent.quiet;
            horizontal-stretch: 1;
            activated => { root.expanded = !root.expanded; root.toggled(); }
        }
        if root.expanded: WorkView { graphs: root.graphs; compact: true; }
    }
}