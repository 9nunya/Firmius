import { Theme } from "../foundation/theme.slint";
import { WorkGraphRow } from "../models.slint";
import { GlintText } from "../kit/glint-text.slint";
import { ScrollView } from "std-widgets.slint";

// Compact, readable todo/workflow surface. The hierarchy is expressed by a
// continuous rail and state glyphs; no internal graph ids or JSON are shown.
export component TaskList inherits Rectangle {
    in property <WorkGraphRow> graph;
    in property <bool> compact: false;
    height: content.preferred-height + 12px;
    background: Theme.window;
    border-width: 1px; border-color: Theme.border; border-radius: 8px;
    clip: true;
    content := VerticalLayout {
        padding: 12px; spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 26px; height: 26px; border-radius: 13px;
                background: Theme.raised;
                Path { x: 6px; y: 6px; width: 14px; height: 14px; viewbox-width: 14; viewbox-height: 14; commands: "M7 1 A6 6 0 1 1 7 13 A6 6 0 1 1 7 1"; fill: transparent; stroke: Theme.accent; stroke-width: 1.5px; }
                Text { text: root.graph.completed + "/" + root.graph.nodes.length; color: Theme.text; font-size: 7px; horizontal-alignment: center; vertical-alignment: center; }
            }
            VerticalLayout { spacing: 1px; horizontal-stretch: 1;
                Text { text: root.graph.title == "" ? "Agent todos" : root.graph.title; color: Theme.text; font-size: Theme.interface-size; font-weight: 600; overflow: elide; }
                if root.graph.assigned != "": Text { text: "Assigned · " + root.graph.assigned; color: Theme.secondary; font-size: Theme.secondary-size; overflow: elide; }
                if root.graph.edges.length > 0: Text { text: root.graph.edges.length + " dependency links"; color: Theme.accent; font-size: Theme.secondary-size; overflow: elide; }
            }
        }
        if root.graph.nodes.length > 1: ScrollView {
            height: 32px;
            horizontal-scrollbar-policy: always-off;
            viewport-width: flow-content.preferred-width;
            viewport-height: self.visible-height;
            flow-content := HorizontalLayout {
                spacing: 6px;
                padding-left: 8px; padding-right: 8px;
                Text { text: "FLOW"; color: Theme.secondary; font-size: 9px; font-weight: 600; vertical-alignment: center; }
                for node[index] in root.graph.nodes: Rectangle {
                    width: 18px; height: 18px; border-radius: 9px;
                    background: node.complete ? Theme.accent : (node.active ? Theme.selected : Theme.canvas);
                    border-width: 1px; border-color: node.failed ? Theme.error : (node.active ? Theme.accent : Theme.border);
                    Path { visible: node.complete; x: 4px; y: 4px; width: 10px; height: 10px; viewbox-width: 12; viewbox-height: 12; commands: "M2 6 L5 9 L10 3"; stroke: Theme.on-primary; stroke-width: 1.5px; }
                    Rectangle { visible: index < root.graph.nodes.length - 1; x: 18px; y: 8px; width: 30px; height: 2px; background: node.complete ? Theme.accent : Theme.border; }
                }
            }
        }
        for node[index] in root.graph.nodes: Rectangle {
            height: root.compact ? 32px : (node.detail == "" ? 38px : 52px);
            private property <bool> entered: false;
            opacity: self.entered ? 1 : 0;
            animate opacity { duration: 160ms; easing: ease-out; }
            Timer { running: true; interval: index * 25ms; triggered => { parent.entered = true; self.running = false; } }
            background: node.active ? Theme.raised : transparent;
            border-radius: 6px;
            HorizontalLayout {
                spacing: 8px; padding-left: 4px; padding-right: 4px;
                Rectangle { width: 20px;
                    Rectangle { x: 9px; y: 0px; width: 1px; height: parent.height; background: index < root.graph.nodes.length - 1 ? Theme.border : transparent; }
                    Rectangle { x: 3px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; border-radius: 7px; border-width: 1px; border-color: node.failed ? Theme.error : (node.complete || node.active ? Theme.accent : Theme.border); background: node.complete ? Theme.accent : Theme.canvas;
                        Path { visible: node.complete; x: 3px; y: 3px; width: 8px; height: 8px; viewbox-width: 12; viewbox-height: 12; commands: "M2 6 L5 9 L10 3"; stroke: Theme.on-primary; stroke-width: 1.5px; }
                        Rectangle { visible: node.active; x: 4px; y: 4px; width: 6px; height: 6px; border-radius: 3px; background: Theme.accent; }
                    }
                }
                VerticalLayout { spacing: 2px; horizontal-stretch: 1;
                    if node.active: GlintText { text: node.title; active: true; font-size: Theme.interface-size; }
                    if !node.active: Text { text: node.title; color: node.complete ? Theme.secondary : Theme.text; font-size: Theme.interface-size; overflow: elide; }
                    if !root.compact && node.detail != "": Text { text: node.detail; color: Theme.secondary; font-size: Theme.secondary-size; overflow: elide; }
                }
                Rectangle {
                    visible: !node.complete && node.state != "Pending";
                    width: state-label.preferred-width + 14px; height: 22px; border-radius: 11px;
                    background: node.failed ? Theme.removed : (node.active ? Theme.selected : Theme.raised);
                    state-label := Text { text: node.state; color: node.failed ? Theme.error : (node.active ? Theme.accent : Theme.secondary); font-size: Theme.secondary-size; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
