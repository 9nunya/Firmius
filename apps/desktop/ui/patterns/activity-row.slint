import { Theme } from "../foundation/theme.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { ToolIcon } from "../kit/tool-icon.slint";
import { GlintText } from "../kit/glint-text.slint";
import { StateGlyph } from "../kit/state-glyph.slint";
export component ActivityRow inherits Rectangle {
    in property <string> summary;
    in property <string> kind;
    in property <string> status;
    in property <bool> failed;
    in property <bool> expanded;
    callback toggle;
    min-height: 42px;
    preferred-height: 42px;
    max-height: 42px;
    vertical-stretch: 0;
    background: root.expanded ? Theme.raised : transparent;
    border-radius: Theme.radius;
    animate background { duration: Theme.motion-disclosure; easing: ease-out; }
    HorizontalLayout {
        padding-left: 2px; padding-right: 4px;
        spacing: 6px;
        Button { label: root.expanded ? "v" : ">"; intent: ButtonIntent.quiet; min-width: 24px; max-width: 24px; accessible-label: root.expanded ? "Collapse details" : "Expand details"; activated => { root.toggle(); } }
        Rectangle {
            width: 24px; height: 24px; border-radius: 7px;
            background: Theme.raised;
            ToolIcon { x: 3px; y: 3px; kind: root.kind; }
        }
        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            GlintText { text: root.summary; active: root.status == "Preparing" || root.status == "Running" || root.status == "Process running" || root.status == "Agent working" || root.status == "streaming" || root.status == "reasoning"; horizontal-stretch: 1; }
            Text {
                visible: root.status == "Preparing" || root.status == "Running" || root.status == "Process running" || root.status == "Agent working" || root.status == "streaming" || root.failed;
                text: root.failed ? "Needs attention" : root.status;
                color: root.failed ? Theme.error : Theme.secondary;
                font-size: Theme.secondary-size;
                overflow: elide;
            }
        }
        StateGlyph { state: root.status; failed: root.failed; }
    }
}
