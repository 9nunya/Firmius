import { Theme } from "foundation/theme.slint";
import { ModelPickerPanel } from "views/model-picker.slint";
import { TitleEditorPanel } from "views/title-editor.slint";
import { PersonaPanel } from "views/persona.slint";
import { SshPanel } from "views/ssh.slint";
import { GoalPanel } from "views/goal.slint";
import { McpPanel } from "views/mcp.slint";
import { SearchPanel } from "views/search.slint";
import { MemoryPanel } from "views/memory.slint";
import { CommandPalettePanel } from "views/command-palette.slint";
import { PermissionPanel } from "views/permission.slint";
import { OnboardingPanel } from "views/onboarding.slint";
import { LoginPanel } from "views/login.slint";
import { AccountsPanel } from "views/accounts.slint";
import { WorkflowEditorPanel } from "views/workflow-editor.slint";
import {
    ActivityData,
    ActivityPreview, TerminalSpan, TerminalLine,
    WorkNodeRow, WorkEdgeRow, WorkGraphRow,
    FileChangeRow,
    CodeLine,
    MatchRow,
    ResourceRow,
    SplitRow,
    ViewportRow,
    SessionRow,
    TabRow,
    BlockRow,
    TranscriptRow,
    AgentRow,
    ModelOption,
    EffortOption,
    CommandRow,
    SshRow,
    AccountRow,
} from "models.slint";
import { ShellViewport } from "shell/viewport.slint";
import { ShellSidebar } from "shell/sidebar.slint";
import { IconButton } from "kit/icon-button.slint";
import { StatusBadge, StatusTone } from "kit/status-badge.slint";

export component MainWindow inherits Window {
    title: "Firmius";
    no-frame: true;
    resize-border-width: 8px;
    preferred-width: 1280px;
    preferred-height: 850px;
    min-width: 320px;
    min-height: 480px;
    background: Theme.window;
    in-out property <bool> native-titlebar-overlay: false;
    in-out property <bool> sidebar-collapsed: false;
    // Overlay/drawer is a window-width decision. Compact pane-switcher mode is
    // independent so collapsing the rail cannot smush or hide splits.
    private property <bool> sidebar-overlay: self.width < 840px;
    changed sidebar-collapsed => { root.save_layout(); }
    in-out property <string> connection_status: "Connecting…";
    in-out property <string> theme_name: "firmius";
    in-out property <string> daemon_detail: "";
    in-out property <string> workspace: "";
    in-out property <string> live_status: "Ready for a task";
    in-out property <string> focus_status: "No agent selected";
    in-out property <string> notice: "";
    in-out property <string> active_title: "Open a session";
    in-out property <string> active_detail: "Choose a saved session or create a new one.";
    in-out property <string> active_provider: "";
    in-out property <string> active_model: "";
    in-out property <string> active_effort: "Default";
    in-out property <string> focused_agent_id: "";
    in-out property <string> active_view: "conversation";
    in-out property <bool> submitting: false;
    in-out property <bool> turn_active: false;
    in-out property <bool> model_picker_open: false;
    in-out property <bool> title_editor_open: false;
    in-out property <bool> command_palette_open: false;
    in-out property <bool> permission_open: false;
    in-out property <bool> onboarding_open: false;
    in-out property <bool> login_open: false;
    in-out property <bool> accounts_open: false;
    in-out property <bool> workflow_editor_open: false;
    in-out property <bool> persona_open: false;
    in-out property <bool> ssh_open: false;
    in-out property <string> ssh_alias: "";
    in-out property <string> ssh_directory: "/";
    in-out property <bool> goal_open: false;
    in-out property <string> goal_description: "";
    in-out property <string> goal_check: "";
    in-out property <bool> mcp_open: false;
    in-out property <string> mcp_name: "";
    in-out property <string> mcp_command: "";
    in-out property <string> mcp_url: "";
    in-out property <string> mcp_args: "";
    in-out property <bool> search_open: false;
    in-out property <bool> memory_open: false;
    in-out property <string> memory_query: "";
    in-out property <string> search_mode: "off";
    in-out property <string> persona_draft: "";
    in-out property <string> workflow_title: "";
    in-out property <string> workflow_brief: "";
    in-out property <string> workflow_steps: "";
    in-out property <string> login_provider: "";
    in-out property <string> login_account_id: "";
    in-out property <string> login_secret: "";
    in-out property <string> permission_request_id: "";
    in-out property <string> permission_tool: "";
    in-out property <string> permission_detail: "";
    in-out property <string> title_draft: "";
    in-out property <string> export_path: "";
    in-out property <string> composer_text: "";
    in-out property <string> expanded_tool_key: "__all__";
    in-out property <string> model_provider_draft: "";
    in-out property <string> model_draft: "";
    in-out property <string> effort_draft: "";
    in-out property <string> new_provider: "";
    in-out property <string> new_model: "";
    in-out property <string> new_workspace: "";
    in-out property <[SessionRow]> sessions: [];
    in-out property <[TranscriptRow]> transcript: [];
    in-out property <[AgentRow]> agents: [];
    in-out property <[ModelOption]> model_options: [];
    in-out property <[EffortOption]> effort_options: [];
    in-out property <[SshRow]> ssh_hosts: [];
    in-out property <[AccountRow]> accounts: [];
    in-out property <[CommandRow]> command_results: [];
    in-out property <int> command_selected: 0;
    in-out property <string> command_query: "";
    in-out property <string> model_query: "";
    in-out property <bool> model_for_new: false;
    callback filter_commands(string);
    callback execute_command(string);
    callback filter_models(string);
    in-out property <bool> settings_autosave: true;
    in-out property <bool> settings_thinking: true;
    in-out property <string> settings_output: "32000";
    callback save_settings;
    callback refresh;
    callback open_session(string);
    callback toggle_session_host(string);
    callback toggle_session_workspace(string);
    callback new_thread_in(string, string);
    callback select_tab(string);
    callback close_tab(string);
    callback split_view;
    callback split_below;
    callback next_pane;
    callback reopen_tab;
    callback layout_resized(float, float);
    callback save_layout;
    in-out property <bool> compact_layout;
    out property <float> workspace_width: workspace-panes.width / 1px;
    callback drag_tab(string, float, float, bool);
    in-out property <bool> drop_visible;
    in-out property <float> drop_x;
    in-out property <float> drop_y;
    in-out property <float> drop_width;
    in-out property <float> drop_height;
    out property <float> workspace_height: workspace-panes.height / 1px;
    changed workspace_width => { root.layout_resized(root.workspace_width, root.workspace_height); }
    changed workspace_height => { root.layout_resized(root.workspace_width, root.workspace_height); }
    callback resize_split(string, float);
    in-out property <[SplitRow]> split_handles;
    callback show_document(string, [TranscriptRow]);
    callback viewport_toggle(string, string);
    callback workflow_toggle(string);
    callback refresh_output(string);
    callback activity_action(string, string, string, string);
    in-out property <[ViewportRow]> viewports: [];
    callback send_message(string);
    callback view_scrolled(string, float, bool);
    callback row_measured(string, string, float, float);
    callback rewind_view(string, string, string);
    callback edit_view_draft(string, string);
    callback edit_view_workspace(string, string);
    callback submit_view(string);
    callback stop_view(string);
    callback model_for_view(string);
    callback commands_for_view(string);
    callback cancel_turn;
    callback save_session;
    callback compact;
    callback rewind;
    callback edit_history(string);
    callback create_session(string, string, string);
    callback connect_ssh(string, string);
    callback save_ssh(string, string);
    callback use_saved_ssh(string);
    callback create_goal(string, string, bool);
    callback manage_mcp(string, string);
    callback add_mcp(string, string, string, string);
    callback apply_search(string);
    callback search_memory(string);
    callback set_view(string);
    callback select_agent(string);
    callback open_model_picker;
    callback apply_model(string, string, string);
    callback set_title(string);
    callback export_session(string);
    callback run_command(string);
    callback resolve_permission(string);
    callback complete_onboarding;
    callback toggle_tool(string);
    callback build_workflow(string, string, string);
    callback choose_model(string, string);
    callback choose_effort(string);
    callback apply_persona(string);
    callback remove_account(string);
    callback native_window_action(string);
    callback set_permission_mode(string, string);
    callback focus_pane(string);
    callback shell_shortcut(string);
    private property <int> composer-focus-revision: 0;
    changed width => {
        if root.sidebar-overlay {
            root.sidebar-collapsed = true;
        }
    }

    FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta) && event.text == "k" {
                root.command_palette_open = !root.command_palette_open;
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == "t" { root.reopen_tab(); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "n" { root.run_command("new"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "," { root.run_command("settings"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == "e" { root.run_command("export"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == "p" { root.run_command("permissions"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "o" { root.command_palette_open = true; return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "s" { root.save_session(); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "w" { root.shell_shortcut("close-tab"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "l" { root.composer-focus-revision += 1; return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "." { root.cancel_turn(); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.text == Key.Return { root.shell_shortcut("send"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "\\" {
                if event.modifiers.shift { root.split_below(); } else { root.split_view(); }
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.text == Key.Tab {
                root.shell_shortcut(event.modifiers.shift ? "previous-tab" : "next-tab"); return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.text >= "1" && event.text <= "9" {
                root.shell_shortcut("tab-" + event.text); return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.alt && event.text == Key.LeftArrow { root.shell_shortcut("focus-left"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.alt && event.text == Key.RightArrow { root.shell_shortcut("focus-right"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.alt && event.text == Key.UpArrow { root.shell_shortcut("focus-up"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.alt && event.text == Key.DownArrow { root.shell_shortcut("focus-down"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == Key.LeftArrow { root.shell_shortcut("move-left"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == Key.RightArrow { root.shell_shortcut("move-right"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == Key.UpArrow { root.shell_shortcut("move-up"); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == Key.DownArrow { root.shell_shortcut("move-down"); return accept; }
            if root.command_palette_open && event.text == Key.DownArrow { root.command_selected = min(root.command_selected + 1, root.command_results.length - 1); return accept; }
            if root.command_palette_open && event.text == Key.UpArrow { root.command_selected = max(root.command_selected - 1, 0); return accept; }
            if event.text == Key.Escape {
                if root.accounts_open { root.accounts_open = false; }
                else if root.login_open { root.login_open = false; }
                else if root.workflow_editor_open { root.workflow_editor_open = false; }
                else if root.model_picker_open { root.model_picker_open = false; }
                else if root.title_editor_open { root.title_editor_open = false; }
                else if root.persona_open { root.persona_open = false; }
                else if root.ssh_open { root.ssh_open = false; }
                else if root.goal_open { root.goal_open = false; }
                else if root.mcp_open { root.mcp_open = false; }
                else if root.search_open { root.search_open = false; }
                else if root.memory_open { root.memory_open = false; }
                else if root.command_palette_open { root.command_palette_open = false; }
                else if root.sidebar-overlay && !root.sidebar-collapsed { root.sidebar-collapsed = true; }
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.window;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                Rectangle {
                    height: 46px;
                    background: Theme.window;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 14px;
                        spacing: 10px;
                        if root.native-titlebar-overlay: HorizontalLayout {
                            width: 62px; spacing: 8px; alignment: center;
                            Rectangle {
                                width: 12px; height: 12px; border-radius: 6px; background: #ff5f57;
                                TouchArea { clicked => { root.native_window_action("close"); } }
                            }
                            Rectangle {
                                width: 12px; height: 12px; border-radius: 6px; background: #febc2e;
                                TouchArea { clicked => { root.native_window_action("minimize"); } }
                            }
                            Rectangle {
                                width: 12px; height: 12px; border-radius: 6px; background: #28c840;
                                TouchArea { clicked => { root.native_window_action("zoom"); } }
                            }
                        }
                        IconButton {
                            accessible-name: root.sidebar-collapsed ? "Open sidebar" : "Close sidebar";
                            tooltip: root.sidebar-collapsed ? "Open sidebar" : "Close sidebar";
                            icon-path: "M4 4 L20 4 L20 20 L4 20 Z M9 4 L9 20";
                            selected: !root.sidebar-collapsed;
                            activated => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                        }
                        Text {
                            text: root.active_title == "Open a session" ? "Firmius" : root.active_title;
                            color: Theme.text; font-size: 14px; font-weight: 600;
                            vertical-alignment: center; overflow: elide;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.connection_status != "Daemon connected": StatusBadge {
                            label: root.connection_status;
                            tone: root.connection_status == "Daemon unavailable" ? StatusTone.danger : (root.connection_status == "Reconnecting…" ? StatusTone.warning : StatusTone.info);
                        }
                    }
                }
                HorizontalLayout {
                    padding: 0px;
                    spacing: 0px;
                    vertical-stretch: 1;
                    if !root.sidebar-overlay: ShellSidebar {
                        sessions: root.sessions;
                        collapsed: root.sidebar-collapsed;
                        collapse => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                        new-task => { root.run_command("new"); }
                        open-session(id) => { root.open_session(id); }
                        toggle-host(id) => { root.toggle_session_host(id); }
                        toggle-workspace(id) => { root.toggle_session_workspace(id); }
                        new-thread(host, workspace) => { root.new_thread_in(host, workspace); }
                        commands => { root.command_palette_open = true; }
                        settings => { root.run_command("settings"); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        background: Theme.canvas;
                        VerticalLayout {
                            padding: 0px;
                            spacing: 0px;
                            workspace-panes := Rectangle {
                                vertical-stretch: 1;
                                for pane in root.viewports: ShellViewport {
                                    visible: !root.compact_layout || pane.focused;
                                    x: root.compact_layout ? 0px : pane.x * parent.width;
                                    y: root.compact_layout ? 0px : pane.y * parent.height;
                                    width: root.compact_layout ? (pane.focused ? parent.width : 0px) : pane.width * parent.width;
                                    height: root.compact_layout ? (pane.focused ? parent.height : 0px) : pane.height * parent.height;
                                    pane: pane;
                                    models: root.model_options;
                                    filter-models(text) => { root.filter_models(text); }
                                    apply-model(provider, model, effort) => { root.apply_model(provider, model, effort); }
                                    settings-autosave <=> root.settings_autosave;
                                    settings-thinking <=> root.settings_thinking;
                                    settings-output <=> root.settings_output;
                                    save-settings => { root.save_settings(); }
                                    select-tab(id) => { root.select_tab(id); }
                                    close-tab(id) => { root.close_tab(id); }
                                    drag-tab(id, x, y, released) => { root.drag_tab(id, (x - workspace-panes.absolute-position.x / 1px) / root.workspace_width, (y - workspace-panes.absolute-position.y / 1px) / root.workspace_height, released); }
                                    scrolled(id, y, following) => { root.view_scrolled(id, y, following); }
                                    measured(id, key, y, height) => { root.row_measured(id, key, y, height); }
                                    rewind(id, key, body) => { root.rewind_view(id, key, body); }
                                    draft-edited(id, text) => { root.edit_view_draft(id, text); }
                                    workspace-edited(id, text) => { root.edit_view_workspace(id, text); }
                                    submit(id) => { root.submit_view(id); }
                                    stop(id) => { root.stop_view(id); }
                                    choose-model(id) => { root.model_for_view(id); }
                                    select-agent(tab, agent) => { root.select_tab(tab); root.select_agent(agent); }
                                    commands(id) => { root.commands_for_view(id); }
                                    settings-action(action) => { root.run_command(action); }
                                    set-permission-mode(id, mode) => { root.set_permission_mode(id, mode); }
                                    default-model: root.new_model;
                                    refresh-output(id) => { root.refresh_output(id); }
                                    action(id, key, action, target) => { root.activity_action(id, key, action, target); }
                                    toggle(id, key) => { root.viewport_toggle(id, key); }
                                    toggle-workflow(id) => { root.workflow_toggle(id); }
                                    focus-request: root.composer-focus-revision;
                                    activated => { root.focus_pane(pane.id); }
                                }
                                for handle in root.split_handles: Rectangle {
                                    visible: !root.compact_layout;
                                    x: (handle.x + (handle.horizontal ? handle.width * handle.ratio : 0)) * parent.width - (handle.horizontal ? 4px : 0px);
                                    y: (handle.y + (handle.horizontal ? 0 : handle.height * handle.ratio)) * parent.height - (handle.horizontal ? 0px : 4px);
                                    width: handle.horizontal ? 8px : handle.width * parent.width;
                                    height: handle.horizontal ? handle.height * parent.height : 8px;
                                    background: splitter.has-hover || splitter.pressed ? Theme.border : transparent;
                                    splitter := TouchArea {
                                        mouse-cursor: handle.horizontal ? ew-resize : ns-resize;
                                        private property <length> origin;
                                        private property <float> start-ratio;
                                        pointer-event(event) => {
                                            if event.kind == PointerEventKind.up { root.save_layout(); }
                                            if event.kind == PointerEventKind.down {
                                                self.origin = handle.horizontal ? self.absolute-position.x + self.mouse-x : self.absolute-position.y + self.mouse-y;
                                                self.start-ratio = handle.ratio;
                                            }
                                        }
                                        moved => {
                                            if self.pressed {
                                                root.resize_split(handle.id, self.start-ratio + ((handle.horizontal ? self.absolute-position.x + self.mouse-x : self.absolute-position.y + self.mouse-y) - self.origin) / (handle.horizontal ? workspace-panes.width * handle.width : workspace-panes.height * handle.height));
                                            }
                                        }
                                    }
                                }
                                if root.drop_visible: Rectangle {
                                    x: root.drop_x * parent.width + 4px;
                                    y: root.drop_y * parent.height + 4px;
                                    width: root.drop_width * parent.width - 8px;
                                    height: root.drop_height * parent.height - 8px;
                                    background: #94dcb125; border-width: 2px; border-color: Theme.accent; border-radius: 8px;
                                    Text { text: "Release to place tab"; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            if root.compact_layout && root.viewports.length > 1: HorizontalLayout {
                                height: Theme.control-height;
                                padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: Theme.space-1;
                                Text { text: "Panes"; color: Theme.text-secondary; font-size: Theme.caption-size; vertical-alignment: center; }
                                for pane in root.viewports: IconButton {
                                    accessible-name: pane.focused ? "Focused pane" : "Focus pane";
                                    tooltip: pane.focused ? "Focused pane" : "Focus pane";
                                    selected: pane.focused;
                                    icon-path: "M5 5 L19 5 L19 19 L5 19 Z";
                                    activated => { root.focus_pane(pane.id); }
                                }
                            }
                            Rectangle {
                                height: max(Theme.control-height, Theme.space-8);
                                background: Theme.bg-window;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: Theme.space-3; padding-right: Theme.space-3; spacing: Theme.space-3;
                                    Text { text: root.focus_status == "" ? "No agent selected" : root.focus_status; color: Theme.text-secondary; font-size: Theme.caption-size; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.live_status; color: Theme.text-secondary; font-size: Theme.caption-size; overflow: elide; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

            }

            if root.sidebar-overlay && !root.sidebar-collapsed: Rectangle {
                y: 46px; width: parent.width; height: parent.height - 46px;
                background: Theme.bg-scrim;
                TouchArea { clicked => { root.sidebar-collapsed = true; } }
                ShellSidebar {
                    width: min(320px, parent.width - Theme.space-12);
                    height: parent.height;
                    sessions: root.sessions;
                    collapse => { root.sidebar-collapsed = true; }
                    new-task => { root.run_command("new"); root.sidebar-collapsed = true; }
                    open-session(id) => { root.open_session(id); root.sidebar-collapsed = true; }
                    toggle-host(id) => { root.toggle_session_host(id); }
                    toggle-workspace(id) => { root.toggle_session_workspace(id); }
                    new-thread(host, workspace) => { root.new_thread_in(host, workspace); root.sidebar-collapsed = true; }
                    commands => { root.command_palette_open = true; root.sidebar-collapsed = true; }
                    settings => { root.run_command("settings"); root.sidebar-collapsed = true; }
                }
            }

            if root.model_picker_open: ModelPickerPanel {
                apply_model(provider, model, effort) => { root.apply_model(provider, model, effort); }
                choose_effort(effort) => { root.choose_effort(effort); }
                choose_model(provider, model) => { root.choose_model(provider, model); }
                effort_draft <=> root.effort_draft;
                effort_options <=> root.effort_options;
                filter_models(query) => { root.filter_models(query); }
                model_draft <=> root.model_draft;
                model_for_new <=> root.model_for_new;
                model_options <=> root.model_options;
                model_picker_open <=> root.model_picker_open;
                model_provider_draft <=> root.model_provider_draft;
                model_query <=> root.model_query;
                new_workspace <=> root.new_workspace;
            }

            if root.title_editor_open: TitleEditorPanel {
                set_title(a0) => { root.set_title(a0); }
                title_draft <=> root.title_draft;
                title_editor_open <=> root.title_editor_open;
            }
            if root.persona_open: PersonaPanel {
                apply_persona(a0) => { root.apply_persona(a0); }
                persona_draft <=> root.persona_draft;
                persona_open <=> root.persona_open;
            }
            if root.ssh_open: SshPanel {
                connect_ssh(a0, a1) => { root.connect_ssh(a0, a1); }
                save_ssh(a0, a1) => { root.save_ssh(a0, a1); }
                ssh_alias <=> root.ssh_alias;
                ssh_directory <=> root.ssh_directory;
                ssh_hosts <=> root.ssh_hosts;
                ssh_open <=> root.ssh_open;
                use_saved_ssh(a0) => { root.use_saved_ssh(a0); }
            }
            if root.goal_open: GoalPanel {
                create_goal(a0, a1, a2) => { root.create_goal(a0, a1, a2); }
                goal_check <=> root.goal_check;
                goal_description <=> root.goal_description;
                goal_open <=> root.goal_open;
            }
            if root.mcp_open: McpPanel {
                add_mcp(a0, a1, a2, a3) => { root.add_mcp(a0, a1, a2, a3); }
                manage_mcp(a0, a1) => { root.manage_mcp(a0, a1); }
                mcp_args <=> root.mcp_args;
                mcp_command <=> root.mcp_command;
                mcp_name <=> root.mcp_name;
                mcp_open <=> root.mcp_open;
                mcp_url <=> root.mcp_url;
            }
            if root.search_open: SearchPanel {
                apply_search(a0) => { root.apply_search(a0); }
                search_open <=> root.search_open;
            }
            if root.memory_open: MemoryPanel {
                open <=> root.memory_open;
                query <=> root.memory_query;
                search(a0) => { root.search_memory(a0); }
            }
            if root.command_palette_open: CommandPalettePanel {
                command_palette_open <=> root.command_palette_open;
                command_query <=> root.command_query;
                command_results <=> root.command_results;
                command_selected <=> root.command_selected;
                execute_command(a0) => { root.execute_command(a0); }
                filter_commands(a0) => { root.filter_commands(a0); }
            }
            if root.permission_open: PermissionPanel {
                permission_detail <=> root.permission_detail;
                permission_open <=> root.permission_open;
                permission_tool <=> root.permission_tool;
                resolve_permission(a0) => { root.resolve_permission(a0); }
            }
            if root.onboarding_open: OnboardingPanel {
                complete_onboarding() => { root.complete_onboarding(); }
                onboarding_open <=> root.onboarding_open;
            }
            if root.login_open: LoginPanel {
                login_account_id <=> root.login_account_id;
                login_open <=> root.login_open;
                login_provider <=> root.login_provider;
                login_secret <=> root.login_secret;
                run_command(a0) => { root.run_command(a0); }
            }
            if root.accounts_open: AccountsPanel {
                open <=> root.accounts_open;
                accounts: root.accounts;
                add-account => { root.accounts_open = false; root.login_open = true; }
                remove-account(id) => { root.remove_account(id); }
            }
            if root.workflow_editor_open: WorkflowEditorPanel {
                build_workflow(a0, a1, a2) => { root.build_workflow(a0, a1, a2); }
                workflow_brief <=> root.workflow_brief;
                workflow_editor_open <=> root.workflow_editor_open;
                workflow_steps <=> root.workflow_steps;
                workflow_title <=> root.workflow_title;
            }
            if root.notice != "": Rectangle {
                x: parent.width - self.width - 16px;
                y: 16px;
                width: min(440px, message.preferred-width + 32px);
                height: max(36px, message.preferred-height + 16px);
                background: Theme.raised; border-width: 1px; border-color: Theme.border; border-radius: 7px;
                message := Text { x: 16px; y: 8px; width: parent.width - 32px; text: root.notice; color: Theme.text; font-size: Theme.secondary-size; wrap: word-wrap; }
                TouchArea { clicked => { root.notice = ""; } }
                Timer { running: true; interval: 4200ms; triggered => { root.notice = ""; self.running = false; } }
            }
        }
    }
}