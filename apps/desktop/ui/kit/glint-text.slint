import { Theme } from "../foundation/theme.slint";
// Shared activity text. Runtime state stays legible without a looping glow;
// one-way event arrival belongs to ArrivalEdge instead.
export component GlintText inherits Text {
    in property <bool> active: true;
    font-size: Theme.secondary-size;
    horizontal-alignment: left;
    vertical-alignment: center;
    overflow: elide;
    color: root.active ? Theme.text-primary : Theme.text-secondary;
}