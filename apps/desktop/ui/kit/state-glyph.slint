import { Theme } from "../foundation/theme.slint";

export component StateGlyph inherits Rectangle {
    in property <string> state;
    in property <bool> failed;
    private property <bool> active: state == "Preparing" || state == "Running" || state == "Process running" || state == "Agent working" || state == "reasoning";
    private property <bool> pulse: false;
    width: 20px; height: 20px;
    accessible-role: text; accessible-label: state;
    Timer { running: root.active && !Theme.reduce-motion; interval: 420ms; triggered => { root.pulse = !root.pulse; } }
    spinner := Rectangle {
        x: 3px; y: 3px; width: 14px; height: 14px; border-radius: 7px;
        border-width: root.active ? 2px : 0px; border-color: Theme.border;
        animate border-width, border-color { duration: Theme.motion-disclosure; easing: ease-out; }
        if root.active: Rectangle {
            x: Theme.reduce-motion ? 6px : (root.pulse ? 9px : 2px); y: Theme.reduce-motion ? 5px : (root.pulse ? 7px : -1px);
            width: 3px; height: 4px; border-radius: 2px; background: Theme.accent;
            animate x { duration: Theme.reduce-motion ? 0ms : 420ms; easing: ease-in-out; }
            animate y { duration: Theme.reduce-motion ? 0ms : 420ms; easing: ease-in-out; }
        }
    }
    if !root.active: Path {
        x: 3px; y: 3px; width: 14px; height: 14px; viewbox-width: 14; viewbox-height: 14;
        stroke: root.failed ? Theme.error : Theme.secondary; stroke-width: 1.8px; fill: transparent;
        commands: root.failed || root.state == "Interrupted" ? "M3 3 L11 11 M11 3 L3 11" : "M2 7 L5.5 10.5 L12 3.5";
        opacity: 1;
        animate opacity { duration: Theme.motion-modal; easing: ease-out; }
        animate stroke { duration: Theme.motion-disclosure; easing: ease-out; }
    }
}