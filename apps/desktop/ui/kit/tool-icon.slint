import { Theme } from "../foundation/theme.slint";
export component ToolIcon inherits Rectangle {
    in property <string> kind;
    width: 18px; height: 18px;
    Path {
        width: 18px; height: 18px;
        viewbox-width: 24; viewbox-height: 24;
        stroke: Theme.secondary; stroke-width: 1.6px;
        commands: root.kind == "bash" ? "M4 5 L10 11 L4 17 M12 18 L21 18" :
            root.kind == "query" ? "M10 3 A7 7 0 1 0 10 17 A7 7 0 1 0 10 3 M15 15 L22 22" :
            root.kind == "delegate" ? "M6 3 A2 2 0 1 0 6 7 A2 2 0 1 0 6 3 M6 7 L6 17 M6 17 A2 2 0 1 0 6 21 A2 2 0 1 0 6 17 M6 13 L18 13 L18 7 M18 3 A2 2 0 1 0 18 7 A2 2 0 1 0 18 3" :
            root.kind == "edit" ? "M4 17 L5 20 L8 19 L19 8 L16 5 Z M14 7 L17 10" :
            root.kind == "work" || root.kind == "task" || root.kind == "workflow" ? "M12 3 L12 9 M12 9 L6 14 M12 9 L18 14 M6 14 L6 20 M18 14 L18 20" :
            root.kind == "goal" ? "M12 3 L20 8 L12 13 L4 8 Z M4 12 L12 17 L20 12" :
            root.kind == "todo" ? "M5 6 L19 6 M5 12 L19 12 M5 18 L15 18 M18 16 L20 18 L23 14" :
            root.kind == "memory" ? "M7 4 L17 4 L17 20 L7 20 Z M10 8 L14 8 M10 12 L14 12" :
            root.kind == "message" ? "M4 6 L20 6 L20 16 L13 16 L12 20 L11 16 L4 16 Z" :
            root.kind == "mcp" ? "M7 4 L17 4 L20 8 L20 16 L17 20 L7 20 L4 16 L4 8 Z M9 12 L15 12" :
            root.kind == "artifact" ? "M7 3 L15 3 L20 8 L20 21 L7 21 Z M15 3 L15 8 L20 8" :
            root.kind == "thinking" ? "M4 5 L20 5 M4 12 L20 12 M4 19 L14 19" :
            "M5 2 L15 2 L20 7 L20 22 L5 22 Z M15 2 L15 7 L20 7 M8 13 L17 13 M8 17 L15 17";
    }
}
