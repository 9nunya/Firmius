import { Theme } from "../foundation/theme.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { ModalFrame } from "../kit/modal-frame.slint";
import { SettingsSection } from "../patterns/settings-section.slint";
export component PermissionPanel inherits Rectangle {
    in-out property <string> permission_detail;
    in-out property <bool> permission_open;
    in-out property <string> permission_tool;
    callback resolve_permission(string);
    ModalFrame {
        title: "Permission request";
        description: "Review the requested operation. The scrim and Escape never send a decision. Allow once and Deny are the only ways to resolve this request.";
        open: root.permission_open;
        content-width: 680px;
        content-height: 520px;
        // Escape focuses Deny but must not silently allow, deny, or dismiss the gate.
        close-requested => { deny.focus(); }
        SettingsSection {
            title: "Source";
            description: "Tool, session, agent, and queue position are authoritative daemon fields.";
            Text { text: root.permission_tool; color: Theme.text-primary; font-size: Theme.interface-size; font-weight: 600; wrap: word-wrap; }
        }
        SettingsSection {
            title: "Requested actions";
            description: "Human-readable previews. Secrets are not shown.";
            Rectangle {
                vertical-stretch: 1; background: Theme.bg-canvas; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border-subtle;
                Text { x: Theme.space-3; y: Theme.space-3; width: parent.width - Theme.space-6; height: parent.height - Theme.space-6; text: root.permission_detail; color: Theme.text-secondary; font-family: "monospace"; font-size: Theme.caption-size; wrap: word-wrap; }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            deny := Button { label: "Deny"; intent: ButtonIntent.destructive; activated => { root.resolve_permission("deny"); } }
            Rectangle { horizontal-stretch: 1; }
            Button { label: "Allow once"; intent: ButtonIntent.primary; activated => { root.resolve_permission("allow"); } }
        }
    }
}
