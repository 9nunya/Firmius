import { Theme } from "../foundation/theme.slint";
import { Button, ButtonIntent } from "../kit/button.slint";

export component OnboardingPanel inherits Rectangle {
    callback complete_onboarding();
    in-out property <bool> onboarding_open;
    background: Theme.canvas;
    private property <bool> entered: false;
    opacity: entered ? 1 : 0;
    animate opacity { duration: 220ms; easing: ease-out; }
    Timer { running: true; interval: 1ms; triggered => { root.entered = true; self.running = false; } }
    HorizontalLayout {
        alignment: center;
    Rectangle {
        // Centering belongs to the shell layout, so this remains centered in
        // both a full window and a tiled viewport.
        width: min(920px, parent.width - 48px);
        height: min(620px, parent.height - 48px);
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 16px;
        VerticalLayout {
        padding: 24px; spacing: 0px;
        HorizontalLayout {
            height: 34px;
            Text { text: "Firmius"; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
            Button { label: "Skip"; intent: ButtonIntent.quiet; activated => { root.onboarding_open = false; } }
        }
        Rectangle { vertical-stretch: 1; }
        VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            alignment: center;
            spacing: 18px;
            Text { text: "Your work, visible as it happens."; color: Theme.text; font-size: 32px; font-weight: 650; horizontal-alignment: center; }
            Text {
                text: "Firmius keeps conversations, tools, agents, and changes in one workspace. Start locally or open a saved SSH host.";
                color: Theme.secondary; font-size: 15px; wrap: word-wrap; horizontal-alignment: center;
            }
            Rectangle { height: 12px; }
            HorizontalLayout {
                spacing: 12px;
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    horizontal-stretch: 1;
                    width: 210px; height: 132px; background: Theme.raised; border-width: 1px; border-color: Theme.border; border-radius: 10px;
                    private property <bool> entered: false;
                    opacity: entered ? 1 : 0;
                    animate opacity { duration: 220ms; easing: ease-out; }
                    Timer { running: true; interval: 100ms; triggered => { parent.entered = true; self.running = false; } }
                    VerticalLayout { padding: 15px; spacing: 7px;
                        Text { text: "01  Pick a workspace"; color: Theme.accent; font-size: Theme.secondary-size; font-weight: 700; }
                        Text { text: "Local folders and SSH projects stay grouped in the sidebar."; color: Theme.text; font-size: Theme.interface-size; wrap: word-wrap; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    width: 210px; height: 132px; background: Theme.raised; border-width: 1px; border-color: Theme.border; border-radius: 10px;
                    private property <bool> entered: false;
                    opacity: entered ? 1 : 0;
                    animate opacity { duration: 220ms; easing: ease-out; }
                    Timer { running: true; interval: 170ms; triggered => { parent.entered = true; self.running = false; } }
                    VerticalLayout { padding: 15px; spacing: 7px;
                        Text { text: "02  Describe the task"; color: Theme.accent; font-size: Theme.secondary-size; font-weight: 700; }
                        Text { text: "Choose a model in the composer, then send when the task is ready."; color: Theme.text; font-size: Theme.interface-size; wrap: word-wrap; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    width: 210px; height: 132px; background: Theme.raised; border-width: 1px; border-color: Theme.border; border-radius: 10px;
                    private property <bool> entered: false;
                    opacity: entered ? 1 : 0;
                    animate opacity { duration: 220ms; easing: ease-out; }
                    Timer { running: true; interval: 240ms; triggered => { parent.entered = true; self.running = false; } }
                    VerticalLayout { padding: 15px; spacing: 7px;
                        Text { text: "03  Follow the runtime"; color: Theme.accent; font-size: Theme.secondary-size; font-weight: 700; }
                        Text { text: "Tool output, agent todos, and changes update in place."; color: Theme.text; font-size: Theme.interface-size; wrap: word-wrap; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { height: 8px; }
            Button { label: "Start a task  →"; intent: ButtonIntent.primary; activated => { root.complete_onboarding(); } }
        }
        Rectangle { vertical-stretch: 1; }
        }
    }
    }
}
