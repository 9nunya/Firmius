import { Theme } from "../foundation/theme.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { LineEdit } from "../kit/fields.slint";
import { ListView } from "std-widgets.slint";
import { SshRow } from "../models.slint";
import { ModalFrame } from "../kit/modal-frame.slint";
import { SettingsSection } from "../patterns/settings-section.slint";
export component SshPanel inherits Rectangle {
    callback connect_ssh(string, string);
    callback save_ssh(string, string);
    in-out property <string> ssh_alias;
    in-out property <string> ssh_directory;
    in-out property <[SshRow]> ssh_hosts;
    in-out property <bool> ssh_open;
    callback use_saved_ssh(string);
    ModalFrame {
        title: "Remote workspaces";
        description: "Save SSH targets and connect a thread to a remote directory. Paths must be absolute on the remote host.";
        open: root.ssh_open;
        content-width: 680px;
        content-height: 600px;
        close-requested => { root.ssh_open = false; }
        SettingsSection {
            title: "Target";
            description: "Alias comes from SSH config. Directory is the remote working path.";
            LineEdit { text <=> root.ssh_alias; placeholder-text: "SSH host alias"; }
            LineEdit { text <=> root.ssh_directory; placeholder-text: "Remote directory"; }
        }
        SettingsSection {
            title: "Saved targets";
            description: "Selecting a saved host fills the fields; it does not connect until you confirm.";
            if root.ssh_hosts.length == 0: Text { text: "No saved SSH targets yet."; color: Theme.text-secondary; font-size: Theme.caption-size; }
            if root.ssh_hosts.length > 0: ListView {
                vertical-stretch: 1;
                for host in root.ssh_hosts: Button {
                    label: host.alias + "  ·  " + host.directory;
                    elide: true;
                    caption-alignment: left;
                    intent: ButtonIntent.quiet;
                    activated => { root.use_saved_ssh(host.alias); }
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            Button { label: "Close"; intent: ButtonIntent.quiet; activated => { root.ssh_open = false; } }
            Rectangle { horizontal-stretch: 1; }
            Button { label: "Save host"; activated => { root.save_ssh(root.ssh_alias, root.ssh_directory); } }
            Button { label: "Connect"; intent: ButtonIntent.primary; activated => { root.connect_ssh(root.ssh_alias, root.ssh_directory); } }
        }
    }
}
