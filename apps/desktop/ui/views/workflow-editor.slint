import { Theme } from "../foundation/theme.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { LineEdit, TextEdit } from "../kit/fields.slint";
import { ModalFrame } from "../kit/modal-frame.slint";
import { SettingsSection } from "../patterns/settings-section.slint";
export component WorkflowEditorPanel inherits Rectangle {
    callback build_workflow(string, string, string);
    in-out property <string> workflow_brief;
    in-out property <bool> workflow_editor_open;
    in-out property <string> workflow_steps;
    in-out property <string> workflow_title;
    ModalFrame {
        title: "Build a workflow";
        description: "Turn a repeatable brief into visible, inspectable steps. Insert and run still require an exact discovered path.";
        open: root.workflow_editor_open;
        content-width: 720px;
        content-height: 620px;
        close-requested => { root.workflow_editor_open = false; }
        SettingsSection {
            title: "Title";
            LineEdit { text <=> root.workflow_title; placeholder-text: "Workflow title"; }
        }
        SettingsSection {
            title: "Shared brief";
            description: "Context every step can see.";
            TextEdit { text <=> root.workflow_brief; vertical-stretch: 1; wrap: word-wrap; }
        }
        SettingsSection {
            title: "Steps";
            description: "One step per line.";
            TextEdit { text <=> root.workflow_steps; vertical-stretch: 1; wrap: word-wrap; }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            Button { label: "Close"; intent: ButtonIntent.quiet; activated => { root.workflow_editor_open = false; } }
            Rectangle { horizontal-stretch: 1; }
            Button { label: "Build workflow"; intent: ButtonIntent.primary; activated => { root.build_workflow(root.workflow_title, root.workflow_brief, root.workflow_steps); } }
        }
    }
}
