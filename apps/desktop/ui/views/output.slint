import { Theme } from "../foundation/theme.slint";
import { TranscriptRow } from "../models.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { TextEdit } from "../kit/fields.slint";
export component OutputView inherits Rectangle {
    in property <[TranscriptRow]> rows;
    callback refresh;
    background: Theme.canvas;
    VerticalLayout {
        padding: 16px; spacing: 12px;
        HorizontalLayout {
            Text { text: root.rows.length > 0 ? root.rows[0].detail : "Recorded output is unavailable after reopening. Open it again from its tool."; color: Theme.secondary; font-size: Theme.secondary-size; wrap: word-wrap; horizontal-stretch: 1; }
            Button { label: "Refresh"; intent: ButtonIntent.quiet; activated => { root.refresh(); } }
        }
        TextEdit { text: root.rows.length > 0 ? root.rows[0].body : ""; read-only: true; }
    }
}
