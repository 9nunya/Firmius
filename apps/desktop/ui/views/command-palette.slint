import { Theme } from "../foundation/theme.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { LineEdit } from "../kit/fields.slint";
import { ScrollView } from "std-widgets.slint";
import { CommandRow } from "../models.slint";
import { ModalFrame } from "../kit/modal-frame.slint";
import { SettingsSection } from "../patterns/settings-section.slint";
export component CommandPalettePanel inherits Rectangle {
    in-out property <bool> command_palette_open;
    in-out property <string> command_query;
    in-out property <[CommandRow]> command_results;
    in-out property <int> command_selected;
    callback execute_command(string);
    callback filter_commands(string);
    ModalFrame {
        title: "Command center";
        description: "Search desktop actions without memorizing slash commands. Typed arguments stay on the selected command.";
        open: root.command_palette_open;
        content-width: 680px;
        content-height: 640px;
        close-requested => { root.command_palette_open = false; }
        SettingsSection {
            title: "Actions";
            LineEdit { height: Theme.control-height; vertical-stretch: 0; text <=> root.command_query; placeholder-text: "Search actions"; edited(text) => { root.filter_commands(text); } accepted => { root.execute_command(root.command_query); } }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: Theme.space-1;
                    for command[index] in root.command_results: Button { label: command.title + "  ·  " + command.hint; intent: index == root.command_selected ? ButtonIntent.secondary : ButtonIntent.quiet; activated => { root.execute_command(command.id); } }
                    if root.command_results.length == 0: Text { text: "No matching actions"; color: Theme.text-secondary; }
                }
            }
        }
        HorizontalLayout {
            Button { label: "Close"; intent: ButtonIntent.quiet; activated => { root.command_palette_open = false; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
