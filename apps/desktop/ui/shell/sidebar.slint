import { Theme } from "../foundation/theme.slint";
import { SessionRow } from "../models.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { IconButton } from "../kit/icon-button.slint";
import { ToolIcon } from "../kit/tool-icon.slint";
import { ListView } from "std-widgets.slint";

// Window-global navigation. Collapsing this component changes it into a stable
// 48 px rail; compact windows mount the expanded form as an overlay drawer.
export component ShellSidebar inherits Rectangle {
    in property <[SessionRow]> sessions;
    in property <bool> collapsed: false;
    callback collapse;
    callback new-task;
    callback open-session(string);
    callback toggle-host(string);
    callback toggle-workspace(string);
    callback new-thread(string, string);
    callback commands;
    callback settings;

    min-width: root.collapsed ? Theme.space-12 : 208px;
    preferred-width: root.collapsed ? Theme.space-12 : 244px;
    max-width: root.collapsed ? Theme.space-12 : 320px;
    background: Theme.bg-rail;
    border-width: 1px;
    border-color: Theme.border-subtle;
    accessible-role: region;
    accessible-label: "Session navigation";
    clip: true;

    VerticalLayout {
        padding: Theme.space-2;
        spacing: Theme.space-2;
        HorizontalLayout {
            height: Theme.control-height;
            spacing: Theme.space-2;
            if !root.collapsed: Text {
                text: "Firmius";
                color: Theme.text-primary;
                font-size: Theme.title-two-size;
                font-weight: 650;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                accessible-name: root.collapsed ? "Expand sidebar" : "Collapse sidebar";
                tooltip: root.collapsed ? "Expand sidebar" : "Collapse sidebar";
                icon-path: root.collapsed
                    ? "M4 4 L20 4 L20 20 L4 20 Z M9 4 L9 20 M13 8 L17 12 L13 16"
                    : "M4 4 L20 4 L20 20 L4 20 Z M9 4 L9 20 M16 8 L12 12 L16 16";
                activated => { root.collapse(); }
            }
        }

        if root.collapsed: VerticalLayout {
            spacing: Theme.space-2;
            IconButton {
                accessible-name: "New task";
                icon-path: "M12 5 L12 19 M5 12 L19 12";
                intent: ButtonIntent.primary;
                activated => { root.new-task(); }
            }
            IconButton {
                accessible-name: "Command center";
                icon-path: "M4 6 L20 6 L20 18 L4 18 Z M7 10 L10 12 L7 14 M12 14 L17 14";
                activated => { root.commands(); }
            }
            IconButton {
                accessible-name: "Settings";
                icon-path: "M12 3 L14 5 L17 4 L18 7 L21 8 L20 12 L21 16 L18 17 L17 20 L14 19 L12 21 L10 19 L7 20 L6 17 L3 16 L4 12 L3 8 L6 7 L7 4 L10 5 Z M9 12 A3 3 0 1 1 15 12 A3 3 0 1 1 9 12";
                activated => { root.settings(); }
            }
        }

        if !root.collapsed: Button {
            label: "New task";
            intent: ButtonIntent.primary;
            horizontal-stretch: 1;
            activated => { root.new-task(); }
        }
        if !root.collapsed: Text {
            text: "SESSIONS";
            color: Theme.text-secondary;
            font-size: Theme.micro-size;
            font-weight: 600;
            height: Theme.space-5;
            vertical-alignment: center;
        }
        if !root.collapsed: ListView {
            vertical-stretch: 1;
            for row in root.sessions: HorizontalLayout {
                height: row.kind == "thread" ? Theme.space-10 : Theme.space-8;
                spacing: Theme.space-1;
                Button {
                    label: (row.kind == "thread" ? "      " : (row.kind == "workspace" ? "  " : ""))
                        + (row.kind == "thread" ? "" : (row.collapsed ? "›  " : "⌄  ")) + row.title;
                    accessible-label: row.kind + ": " + row.title + (row.detail == "" ? "" : ", " + row.detail);
                    caption-alignment: left;
                    intent: ButtonIntent.quiet;
                    elide: true;
                    horizontal-stretch: 1;
                    activated => {
                        if row.kind == "host" { root.toggle-host(row.key); }
                        else if row.kind == "workspace" { root.toggle-workspace(row.key); }
                        else { root.open-session(row.id); }
                    }
                }
                if row.kind != "thread": IconButton {
                    accessible-name: "New thread in " + row.title;
                    icon-path: "M12 5 L12 19 M5 12 L19 12";
                    activated => { root.new-thread(row.host, row.kind == "workspace" ? row.workspace : ""); }
                }
            }
        }
        if !root.collapsed: Button {
            label: "Command center    Mod K";
            caption-alignment: left;
            intent: ButtonIntent.quiet;
            horizontal-stretch: 1;
            activated => { root.commands(); }
        }
        if !root.collapsed: Button {
            label: "Settings    Mod ,";
            caption-alignment: left;
            intent: ButtonIntent.quiet;
            horizontal-stretch: 1;
            activated => { root.settings(); }
        }
    }
}