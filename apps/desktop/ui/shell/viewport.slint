import { OutputView } from "../views/output.slint";
import { ChangesView } from "../views/changes.slint";
import { GalleryView } from "../gallery/gallery.slint";
import { TabStrip } from "../patterns/tab-strip.slint";
import { Theme } from "../foundation/theme.slint";
import { ComposerFrame } from "../patterns/composer-frame.slint";
import { FollowScrollView } from "../patterns/follow-scroll.slint";
import { ViewportRow, ModelOption } from "../models.slint";
import { TranscriptCard } from "../components/transcript-card.slint";
import { ActionButton } from "../components/primitives.slint";
import { SettingsView } from "../views/settings.slint";
import { WorkView } from "../views/work.slint";
import { LifecycleIndicator } from "../patterns/lifecycle-indicator.slint";
import { WorkflowFloat } from "../patterns/workflow-float.slint";
import { TodoFloat } from "../patterns/todo-float.slint";
import { ToolIcon } from "../kit/tool-icon.slint";
import { ListView, ScrollView } from "std-widgets.slint";
export component ShellViewport inherits Rectangle {
    in property <ViewportRow> pane;
    in-out property <bool> settings-autosave;
    in-out property <bool> settings-thinking;
    in-out property <string> settings-output;
    callback save-settings;
    callback select-tab(string);
    callback close-tab(string);
    callback drag-tab(string, float, float, bool);
    callback toggle(string, string);
    callback toggle-workflow(string);
    callback refresh-output(string);
    callback action(string, string, string, string);
    callback scrolled(string, float, bool);
    callback measured(string, string, float, float);
    callback rewind(string, string, string);
    callback draft-edited(string, string);
    callback workspace-edited(string, string);
    callback submit(string);
    callback stop(string);
    callback choose-model(string);
    callback select-agent(string, string);
    in property <[ModelOption]> models;
    callback filter-models(string);
    callback apply-model(string, string, string);
    callback commands(string);
    callback settings-action(string);
    callback set-permission-mode(string, string);
    callback activated;
    in property <int> focus-request: 0;
    in property <string> default-model;
    min-width: 0px;
    background: Theme.canvas;
    clip: true;
    border-width: 1px;
    border-color: pane.focused ? Theme.border : Theme.window;
    TouchArea { clicked => { root.activated(); } }
    VerticalLayout {
        spacing: 0px;
        TabStrip {
            tabs: root.pane.tabs;
            selected(id) => { root.select-tab(id); }
            closed(id) => { root.close-tab(id); }
            dragged(id, x, y, released) => { root.drag-tab(id, x, y, released); }
        }
        if root.pane.view == "output": OutputView { rows: root.pane.rows; refresh => { root.refresh-output(root.pane.tab-id); } }
        if root.pane.view == "changes": ChangesView { rows: root.pane.rows; action(key, action, target) => { root.action(root.pane.tab-id, key, action, target); } }
        if root.pane.view == "work": WorkView { graphs: root.pane.graphs; }
        if root.pane.view == "gallery": GalleryView {}
        if root.pane.view == "settings": SettingsView {
            autosave <=> root.settings-autosave;
            thinking <=> root.settings-thinking;
            output <=> root.settings-output;
            save => { root.save-settings(); }
            open_accounts => { root.settings-action("accounts"); }
            open_persona => { root.settings-action("persona"); }
            open_ssh => { root.settings-action("ssh"); }
            open_mcp => { root.settings-action("mcp"); }
            open_workflow => { root.settings-action("workflow"); }
            open_goals => { root.settings-action("goals"); }
            open_memory => { root.settings-action("memory"); }
            open_search => { root.settings-action("search"); }
            open_permissions => { root.settings-action("permissions"); }
            open_login => { root.settings-action("login"); }
            open_runtime => { root.settings-action("runtime"); }
            open_work => { root.settings-action("work"); }
            save_session => { root.settings-action("save"); }
            export_session => { root.settings-action("export"); }
            settings_action(action) => { root.settings-action(action); }
        }
        if root.pane.rows.length == 0 && !root.pane.welcome && root.pane.view != "settings" && root.pane.view != "gallery" && root.pane.view != "output" && root.pane.view != "changes" && root.pane.view != "work": Text {
            text: "Open a session or start a task."; color: Theme.secondary;
            horizontal-alignment: center; vertical-alignment: center;
        }
        if root.pane.welcome: Rectangle {
          vertical-stretch: 1;
          background: Theme.canvas;
          private property <bool> entered: false;
          opacity: self.entered ? 1 : 0;
          animate opacity { duration: 220ms; easing: ease-out; }
          Timer { running: true; interval: 1ms; triggered => { parent.entered = true; self.running = false; } }
          Rectangle {
            // Geometry centering avoids a Slint layout feedback loop inside
            // the shell's stretch layout while remaining split-pane safe.
            x: max(24px, (parent.width - min(820px, parent.width - 48px)) / 2);
            y: max(24px, (parent.height - min(470px, parent.height - 48px)) / 2);
            width: min(820px, parent.width - 48px);
            height: min(470px, parent.height - 48px);
            VerticalLayout {
            padding: 24px; spacing: 12px;
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
              height: 52px;
              Rectangle { horizontal-stretch: 1; }
              Rectangle {
                width: 52px; height: 52px; border-radius: 18px;
                background: Theme.raised; border-width: 1px; border-color: Theme.border;
                ToolIcon { x: 15px; y: 15px; width: 22px; height: 22px; kind: "delegate"; }
              }
              Rectangle { horizontal-stretch: 1; }
            }
            Text { height: 38px; text: "What should we build?"; color: Theme.text; font-size: 28px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
            Text {
              height: 24px;
              text: root.pane.workspace == "" ? "Choose a workspace and describe the outcome." : "Starting a new task in  " + root.pane.workspace;
              color: Theme.secondary; font-size: Theme.interface-size; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
            }
            Rectangle { height: 4px; }
            ComposerFrame {
              width: min(720px, parent.width - 8px);
              welcome: true; workspace: root.pane.workspace;
              models: root.models; efforts: root.pane.efforts; effort: root.pane.effort; provider: root.pane.provider;
              draft: root.pane.draft; model-name: root.pane.model-name == "" ? root.default-model : root.pane.model-name;
              agents: root.pane.agents; agent-name: root.pane.agent-name;
              context-path: root.pane.context-path; context-label: root.pane.context-label;
              busy: root.pane.busy; sending: root.pane.sending; error: root.pane.send-error;
              live-phrase: root.pane.live-phrase; permission-mode: root.pane.permission-mode;
              todos: root.pane.todos;
              focus-request: root.focus-request;
              set-permission-mode(mode) => { root.set-permission-mode(root.pane.tab-id, mode); }
              workspace-edited(text) => { root.workspace-edited(root.pane.tab-id, text); }
              filter-models(text) => { root.filter-models(text); }
              apply-model(provider, model, effort) => { root.apply-model(provider, model, effort); }
              select-agent(id) => { root.select-agent(root.pane.tab-id, id); }
              edited(text) => { root.draft-edited(root.pane.tab-id, text); }
              submit => { root.submit(root.pane.tab-id); }
              stop => { root.stop(root.pane.tab-id); }
              choose-model => { root.choose-model(root.pane.tab-id); }
              commands => { root.commands(root.pane.tab-id); }
            }
            Rectangle { vertical-stretch: 1; }
            }
          }
        }
        if !root.pane.welcome && root.pane.view != "settings" && root.pane.view != "gallery" && root.pane.view != "output" && root.pane.view != "changes" && root.pane.view != "work": VerticalLayout {
          vertical-stretch: 1;
          Rectangle {
            vertical-stretch: 1;
            min-width: 0px;
            transcript := FollowScrollView {
              x: max(0px, (parent.width - min(760px, parent.width)) / 2);
              width: min(760px, parent.width);
              height: parent.height;
              view-id: root.pane.tab-id;
              saved-y: root.pane.scroll-y;
              saved-following: root.pane.following;
              reading-changed(y, following) => { root.scrolled(root.pane.tab-id, y, following); }
              measured(key, y, height) => { root.measured(root.pane.tab-id, key, y, height); }
              rows: root.pane.rows;
              expanded: root.pane.expanded;
              toggle(key) => { root.toggle(root.pane.tab-id, key); }
              action(key, action, target) => { root.action(root.pane.tab-id, key, action, target); }
              rewind(key, body) => { root.rewind(root.pane.tab-id, key, body); }
            }
          }
          if !transcript.following: ActionButton {
              label: "Jump to latest ↓";
              activated => { transcript.follow-latest(); }
          }
        }
        if !root.pane.welcome && root.pane.view == "conversation": ComposerFrame {
            models: root.models;
            efforts: root.pane.efforts; effort: root.pane.effort; provider: root.pane.provider;
            filter-models(text) => { root.filter-models(text); }
            apply-model(provider, model, effort) => { root.apply-model(provider, model, effort); }
            agents: root.pane.agents;
            agent-name: root.pane.agent-name;
            context-path: root.pane.context-path;
            context-label: root.pane.context-label;
            select-agent(id) => { root.select-agent(root.pane.tab-id, id); }
            draft: root.pane.draft;
            model-name: root.pane.model-name == "" ? root.default-model : root.pane.model-name;
            busy: root.pane.busy;
            sending: root.pane.sending;
            error: root.pane.send-error;
            live-phrase: root.pane.live-phrase;
            todos: root.pane.todos;
            permission-mode: root.pane.permission-mode;
            focus-request: root.focus-request;
            set-permission-mode(mode) => { root.set-permission-mode(root.pane.tab-id, mode); }
            edited(text) => { root.draft-edited(root.pane.tab-id, text); }
            submit => { root.submit(root.pane.tab-id); }
            stop => { root.stop(root.pane.tab-id); }
            choose-model => { root.choose-model(root.pane.tab-id); }
            commands => { root.commands(root.pane.tab-id); }
            workspace-edited(text) => { root.workspace-edited(root.pane.tab-id, text); }
        }
    }
    if !root.pane.welcome && root.pane.view == "conversation" && root.pane.graphs.length > 0 && root.width >= 300px && root.height >= 220px: WorkflowFloat {
        x: parent.width - self.width - 16px;
        // Float above the composer so it never masks the first transcript
        // passage or the live tool stream at the top of the viewport.
        y: 12px;
        available-width: root.width;
        available-height: root.height;
        graphs: root.pane.graphs;
        expanded: root.pane.workflow-open;
        toggled => { root.toggle-workflow(root.pane.tab-id); }
    }
    if !root.pane.welcome && root.pane.view == "conversation" && root.pane.todos.length > 0 && root.width >= 300px && root.height >= 220px: TodoFloat {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 88px;
        available-width: root.width;
        available-height: root.height;
        graphs: root.pane.todos;
    }
}
