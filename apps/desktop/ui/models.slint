export struct CodeLine { text: string, kind: string, old-number: string, new-number: string }
export struct WorkNodeRow { id: string, title: string, detail: string, state: string, active: bool, failed: bool, complete: bool }
export struct WorkEdgeRow { source: int, target: int }
export struct WorkGraphRow { id: string, title: string, assigned: string, nodes: [WorkNodeRow], edges: [WorkEdgeRow], completed: int }
export struct FileChangeRow { path: string, operation: string, added: int, removed: int, lines: [CodeLine] }
export struct MatchRow { path: string, line: int, text: string }
export struct ResourceRow { id: string, kind: string, label: string, mode: string, state: string, active: bool, failed: bool, agent: string }
export struct ActivityPreview { kind: string, summary: string, state: string, command: string, path: string, query: string, output: string }
export struct TerminalSpan { text: string, ink: color, strong: bool }
export struct TerminalLine { spans: [TerminalSpan] }
export struct ActivityData { terminal: [TerminalLine], children: [ActivityPreview], runtime-active: bool, cwd: string, tool-name: string, files: [FileChangeRow], matches: [MatchRow], lines: [CodeLine], summary: string, intent: string, state: string, invocation: string, command: string, path: string, query: string, brief: string, mode: string, arguments: string, output: string, patch: string, omitted: string, resources: [ResourceRow] }
export struct SessionRow { kind: string, key: string, collapsed: bool, id: string, title: string, detail: string, host: string, workspace: string, project: string }
export struct TabRow { id: string, title: string, selected: bool }
export struct BlockRow { text: string, kind: string, label: string }
export struct TranscriptRow { activity: ActivityData, blocks: [BlockRow], key: string, author: string, body: string, tone: string, detail: string, presenter: string, expandable: bool }
export struct AgentRow { id: string, label: string, detail: string, active: bool }
export struct ModelOption { provider: string, model: string, detail: string }
export struct EffortOption { name: string, detail: string }
export struct CommandRow { id: string, title: string, hint: string }
export struct SshRow { alias: string, directory: string }
export struct AccountRow { id: string, provider: string }

export struct SplitRow { id: string, horizontal: bool, ratio: float, x: float, y: float, width: float, height: float }
export struct ViewportRow { workflow-open: bool, todos: [WorkGraphRow], live-phrase: string, permission-mode: string, workspace: string, welcome: bool, provider: string, effort: string, efforts: [EffortOption], context-path: string, context-label: string, agents: [AgentRow], graphs: [WorkGraphRow], x: float, y: float, width: float, height: float, id: string, tab-id: string, focused: bool, view: string, tabs: [TabRow], rows: [TranscriptRow], expanded: string, draft: string, sending: bool, send-error: string, scroll-y: float, following: bool, busy: bool, model-name: string, agent-name: string }
