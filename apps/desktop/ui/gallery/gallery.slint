import { Theme } from "../foundation/theme.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { LineEdit, TextEdit } from "../kit/fields.slint";
import { IconButton } from "../kit/icon-button.slint";
import { StatusBadge, StatusTone } from "../kit/status-badge.slint";
import { Surface, Elevation } from "../kit/surface.slint";
import { ModalFrame } from "../kit/modal-frame.slint";
import { Divider } from "../kit/divider.slint";
import { ArrivalEdge } from "../kit/motion.slint";
import { ActivityRow } from "../patterns/activity-row.slint";
import { OutputViewer } from "../content/output-viewer.slint";
import { SettingsSection } from "../patterns/settings-section.slint";
import { ScrollView } from "std-widgets.slint";
export component GalleryView inherits Rectangle {
    private property <string> last-action: "No action yet";
    private property <bool> show-output: false;
    private property <bool> show-modal: false;
    background: Theme.bg-canvas;
    ScrollView {
        viewport-height: content.preferred-height;
        content := VerticalLayout {
            padding: Theme.space-6; spacing: Theme.space-6;
            Text { text: "Aurora Forge foundation"; color: Theme.text-primary; font-size: Theme.title-one-size; font-weight: 650; }
            SettingsSection {
                title: "Foundations";
                description: "Theme, density, type, contrast and motion update every specimen together.";
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Button { label: Theme.dark ? "Switch to light" : "Switch to dark"; activated => { Theme.dark = !Theme.dark; } }
                    Button { label: Theme.comfortable ? "Compact density" : "Comfortable density"; activated => { Theme.comfortable = !Theme.comfortable; } }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Button { label: "100% text"; intent: Theme.text-scale == 1 ? ButtonIntent.primary : ButtonIntent.secondary; activated => { Theme.text-scale = 1; } }
                    Button { label: "150% text"; intent: Theme.text-scale == 1.5 ? ButtonIntent.primary : ButtonIntent.secondary; activated => { Theme.text-scale = 1.5; } }
                    Button { label: "200% text"; intent: Theme.text-scale == 2 ? ButtonIntent.primary : ButtonIntent.secondary; activated => { Theme.text-scale = 2; } }
                }
            }
            SettingsSection {
                title: "Actions";
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Button { label: "Primary"; intent: ButtonIntent.primary; activated => { root.last-action = "Primary activated"; } }
                    Button { label: "Secondary"; activated => { root.last-action = "Secondary activated"; } }
                    Button { label: "Quiet"; intent: ButtonIntent.quiet; activated => { root.last-action = "Quiet activated"; } }
                    Button { label: "Destructive"; intent: ButtonIntent.destructive; activated => { root.last-action = "Destructive activated"; } }
                    Button { label: "Disabled"; enabled: false; }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    IconButton {
                        accessible-name: "Search"; tooltip: "Search (Mod+F)";
                        icon-path: "M10.5 3 A7.5 7.5 0 1 0 10.5 18 A7.5 7.5 0 1 0 10.5 3 M16 16 L22 22";
                        activated => { root.last-action = "Search activated"; }
                    }
                    IconButton {
                        accessible-name: "Send"; tooltip: "Send task"; intent: ButtonIntent.primary;
                        icon-path: "M4 4 L21 12 L4 20 L7 12 Z M7 12 L16 12";
                        activated => { root.last-action = "Send activated"; }
                    }
                    IconButton {
                        accessible-name: "Selected work view"; tooltip: "Work"; selected: true;
                        icon-path: "M12 3 L12 9 M12 9 L6 14 M12 9 L18 14 M6 14 L6 21 M18 14 L18 21";
                        activated => { root.last-action = "Work activated"; }
                    }
                    IconButton {
                        accessible-name: "Unavailable copy"; tooltip: "Copy unavailable"; enabled: false;
                        icon-path: "M9 8 L20 8 L20 20 L9 20 Z M4 4 L15 4 L15 8 M4 4 L4 16 L9 16";
                    }
                    Text { text: "Keyboard focus uses an independent ring and shows tooltips immediately."; color: Theme.text-secondary; font-size: Theme.caption-size; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                }
                Text { text: root.last-action; color: Theme.text-secondary; font-size: Theme.caption-size; }
            }
            SettingsSection {
                title: "Status vocabulary";
                description: "Every state retains text and a vector shape; color is supplemental.";
                HorizontalLayout {
                    spacing: Theme.space-2;
                    StatusBadge { label: "Online"; tone: StatusTone.success; }
                    StatusBadge { label: "Connecting"; tone: StatusTone.info; }
                    StatusBadge { label: "Waiting"; tone: StatusTone.warning; }
                    StatusBadge { label: "Failed"; tone: StatusTone.danger; }
                    StatusBadge { label: "Thinking"; tone: StatusTone.thinking; }
                    StatusBadge { label: "Stale"; tone: StatusTone.stale; }
                }
            }
            SettingsSection {
                title: "Fields";
                LineEdit { label: "Task title"; placeholder-text: "Task title"; text: "Desktop foundations"; }
                LineEdit { label: "Validated input"; text: "invalid"; error: "Enter a positive number."; }
                LineEdit { label: "Read-only input"; text: "Read-only value"; read-only: true; }
                LineEdit { label: "Secret"; placeholder-text: "Secret"; input-type: password; }
            }
            SettingsSection {
                title: "Elevation and motion";
                description: "Boundaries carry structure; shadows add occlusion without stacking nested cards.";
                HorizontalLayout {
                    spacing: Theme.space-4;
                    Surface {
                        elevation: Elevation.flat; height: 84px; horizontal-stretch: 1;
                        Text { x: Theme.space-4; y: Theme.space-4; text: "Level 0\nCanvas"; color: Theme.text-primary; font-size: Theme.interface-size; }
                    }
                    Surface {
                        elevation: Elevation.low; height: 84px; horizontal-stretch: 1;
                        Text { x: Theme.space-4; y: Theme.space-4; text: "Level 1\nSurface"; color: Theme.text-primary; font-size: Theme.interface-size; }
                    }
                    Surface {
                        elevation: Elevation.floating; height: 84px; horizontal-stretch: 1;
                        Text { x: Theme.space-4; y: Theme.space-4; text: "Level 2\nFloating"; color: Theme.text-primary; font-size: Theme.interface-size; }
                    }
                    Surface {
                        elevation: Elevation.modal; height: 84px; horizontal-stretch: 1;
                        Text { x: Theme.space-4; y: Theme.space-4; text: "Level 3\nModal"; color: Theme.text-primary; font-size: Theme.interface-size; }
                    }
                }
                Divider {}
                HorizontalLayout {
                    spacing: Theme.space-3;
                    ArrivalEdge { active: true; reduced: false; height: Theme.control-height; }
                    Text { text: "Motion enabled: causal transitions use shared durations."; color: Theme.text-secondary; font-size: Theme.interface-size; vertical-alignment: center; horizontal-stretch: 1; }
                    ArrivalEdge { active: true; reduced: true; height: Theme.control-height; }
                    Text { text: "Reduced: static arrival edge; state and content stay unchanged."; color: Theme.text-secondary; font-size: Theme.interface-size; vertical-alignment: center; horizontal-stretch: 1; }
                }
                Button { label: "Open modal specimen"; activated => { root.show-modal = true; } }
            }
            SettingsSection {
                title: "Tool activity";
                ActivityRow { kind: "bash"; summary: "Preparing bash…"; status: "Preparing"; toggle => { root.last-action = "Preparing invocation selected"; } }
                ActivityRow { kind: "bash"; summary: "cargo test -p firmius-desktop"; status: "Process running"; expanded: root.show-output; toggle => { root.show-output = !root.show-output; } }
                if root.show-output: OutputViewer { text: "Invocation completed\nProcess still running\n\nrunning 24 tests…"; }
                ActivityRow { kind: "query"; summary: "Read session_model.rs"; status: "Completed"; toggle => { root.last-action = "Read invocation selected"; } }
                ActivityRow { kind: "bash"; summary: "cargo check"; status: "Exited 1"; failed: true; toggle => { root.last-action = "Failed process selected"; } }
                ActivityRow { kind: "delegate"; summary: "Review scroll behavior"; status: "Agent working"; toggle => { root.last-action = "Delegate selected"; } }
            }
        }
    }
    if root.show-modal: ModalFrame {
        title: "Review foundation settings";
        description: "A level 3 surface uses a semantic scrim, bounded geometry, and Escape dismissal.";
        content-width: 520px; content-height: 280px;
        close-requested => { root.show-modal = false; }
        Text { text: "Theme: " + (Theme.dark ? "Dark" : "Light") + "\nDensity: " + (Theme.comfortable ? "Comfortable" : "Compact") + "\nMotion contract: enabled and reduced specimens remain semantically identical."; color: Theme.text-primary; font-size: Theme.body-size; wrap: word-wrap; }
        HorizontalLayout {
            spacing: Theme.space-2; alignment: end;
            Button { label: "Cancel"; activated => { root.show-modal = false; } }
            Button { label: "Apply"; intent: ButtonIntent.primary; activated => { root.last-action = "Foundation settings reviewed"; root.show-modal = false; } }
        }
    }
}