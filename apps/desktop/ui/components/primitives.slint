// Compatibility exports while feature callers migrate to the kit API.
import { Theme } from "../foundation/theme.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { IconButton } from "../kit/icon-button.slint";
import { Surface } from "../kit/surface.slint";
import { ModalFrame } from "../kit/modal-frame.slint";
import { StatusBadge } from "../kit/status-badge.slint";
import { Divider } from "../kit/divider.slint";
export component ActionButton inherits Button {
    in property <bool> accent: false;
    intent: accent ? ButtonIntent.primary : ButtonIntent.secondary;
}
export component Dot inherits Rectangle {
    in property <string> kind: "idle";
    width: 6px; height: 6px; border-radius: 3px;
    background: kind == "error" ? Theme.error : (kind == "waiting" ? Theme.warning : Theme.accent);
}
// Compatibility-facing aliases let feature views adopt the kit incrementally.
export component VectorIconButton inherits IconButton {}
export component ElevatedSurface inherits Surface {}
export component DialogFrame inherits ModalFrame {}
export component StateBadge inherits StatusBadge {}
export component Rule inherits Divider {}