import { Theme } from "../foundation/theme.slint";
// Native editing, including IME preedit, is never reimplemented in feature code.
export component ComposerInput inherits Rectangle {
    in-out property <string> text;
    out property <length> text-height: editor.preferred-height;
    callback submit;
    callback commands;
    callback edited(string);
    forward-focus: editor;
    public function request-focus() { editor.focus(); }
    background: transparent;
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return && !event.modifiers.shift && !event.modifiers.alt && editor.preedit-text == "" { root.submit(); return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "k" { root.commands(); return accept; }
            return reject;
        }
        editor := TextInput {
            horizontal-alignment: left;
            vertical-alignment: top;
            text <=> root.text;
            color: Theme.text;
            selection-background-color: Theme.selected;
            selection-foreground-color: Theme.text;
            font-size: Theme.prose-size;
            single-line: false;
            wrap: word-wrap;
            // Keep an empty composer quiet while allowing a draft to grow to
            // the contract's 240 px ceiling without consuming the transcript.
            height: min(240px, max(48px, self.preferred-height));
            edited => { root.edited(self.text); }
        }
    }
    if root.text == "": Text {
        horizontal-alignment: left;
        vertical-alignment: top;
        text: "Message this agent…  Enter to send · Shift Enter for newline";
        color: Theme.secondary;
        font-size: Theme.prose-size;
    }
}