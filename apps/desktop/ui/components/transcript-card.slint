import { BashPresenter } from "presenters/bash.slint";
import { EditPresenter } from "presenters/edit.slint";
import { QueryPresenter } from "presenters/query.slint";
import { DelegatePresenter } from "presenters/delegate.slint";
import { ToolPresenter } from "presenters/tool.slint";
import { WorkPresenter } from "presenters/work.slint";
import { GoalPresenter } from "presenters/goal.slint";
import { TodoPresenter } from "presenters/todo.slint";
import { MemoryPresenter } from "presenters/memory.slint";
import { MessagePresenter } from "presenters/message.slint";
import { ArtifactPresenter } from "presenters/artifact.slint";
import { McpPresenter } from "presenters/mcp.slint";
import { ThinkingPresenter } from "presenters/thinking.slint";
import { TranscriptRow } from "../models.slint";
import { Theme } from "../foundation/theme.slint";
import { ActivityRow } from "../patterns/activity-row.slint";
import { Button, ButtonIntent } from "../kit/button.slint";
import { StreamingText } from "../kit/streaming-text.slint";
// Document flow and activity are distinct structures. No universal title/card.
export component TranscriptCard inherits Rectangle {
    in property <TranscriptRow> entry;
    in property <bool> expanded;
    callback toggle;
    callback action(string, string);
    callback rewind;
    private property <bool> activity: entry.expandable || entry.presenter == "thinking";
    private property <bool> entered: false;
    private property <bool> typed: entry.presenter == "bash" || entry.presenter == "edit" || entry.presenter == "query" || entry.presenter == "delegate" || entry.presenter == "work" || entry.presenter == "goal" || entry.presenter == "todo" || entry.presenter == "memory" || entry.presenter == "message" || entry.presenter == "artifact" || entry.presenter == "mcp" || entry.presenter == "thinking";
    // Keep prose dense enough that the transcript reads as one continuous
    // passage. Activity rows already carry their own visual separation.
    height: content.preferred-height + (activity ? 2px : 8px);
    x: self.entered ? 0px : -8px;
    opacity: self.entered ? 1 : 0;
    animate opacity { duration: Theme.motion-disclosure; easing: ease-out; }
    animate x { duration: Theme.motion-disclosure; easing: ease-out; }
    Timer { running: true; interval: 1ms; triggered => { root.entered = true; self.running = false; } }
    background: transparent;
    content := VerticalLayout {
        padding-left: Theme.space-4; padding-right: Theme.space-4;
        padding-top: root.activity ? 0px : Theme.space-1;
        spacing: Theme.space-1;
        if root.activity: ActivityRow {
            kind: root.entry.presenter;
            summary: root.entry.activity.summary != "" ? root.entry.activity.summary : (root.entry.presenter == "thinking" ? "Reasoning" : root.entry.author);
            status: root.entry.activity.state != "" ? root.entry.activity.state : root.entry.detail;
            failed: root.entry.tone == "error";
            expanded: root.expanded;
            toggle => { root.toggle(); }
        }
        // Compact previews stay visible; expansion reveals evidence, not a
        // second title. ActivityRow already owns verb/object/state.
        if root.activity && (root.expanded || root.typed || root.entry.activity.runtime-active || root.entry.activity.invocation == "Preparing" || root.entry.activity.invocation == "Running"): VerticalLayout {
            padding-left: Theme.space-6; spacing: 6px;
            if root.entry.presenter == "bash": BashPresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "edit": EditPresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "query": QueryPresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "delegate": DelegatePresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "work": WorkPresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "goal": GoalPresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "todo": TodoPresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "memory": MemoryPresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "message": MessagePresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "artifact": ArtifactPresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "mcp": McpPresenter { data: root.entry.activity; expanded: root.expanded; action(action, target) => { root.action(action, target); } }
            if root.entry.presenter == "thinking": ThinkingPresenter { content: root.entry.body; expanded: root.expanded; streaming: root.entry.detail == "streaming"; }
            if !root.typed: ToolPresenter {
                tool-name: root.entry.activity.tool-name;
                summary: root.entry.activity.summary;
                detail: root.entry.activity.arguments;
                status: root.entry.activity.state;
                output: root.entry.activity.output;
                omitted: root.entry.activity.omitted;
                expanded: root.expanded;
                action(action, target) => { root.action(action, target); }
            }
        }
        if !root.activity: Rectangle {
            background: root.entry.tone == "user" ? Theme.raised : transparent;
            border-radius: Theme.radius;
            height: document.preferred-height;
            document := VerticalLayout {
                padding: root.entry.tone == "user" ? Theme.space-3 : 0px;
                spacing: 6px;
                for block in root.entry.blocks: Rectangle {
                    height: block-body.preferred-height;
                    background: block.kind == "addition" ? Theme.diff-add-bg : (block.kind == "deletion" ? Theme.diff-remove-bg : (block.kind == "code" || block.kind == "table" ? Theme.window : transparent));
                    block-body := VerticalLayout {
                        HorizontalLayout {
                            visible: block.kind == "quote";
                            spacing: Theme.space-2;
                            Rectangle { width: 2px; background: Theme.border-strong; }
                            Text {
                                text: block.text; color: Theme.text-secondary; font-size: Theme.prose-size; wrap: word-wrap; horizontal-stretch: 1;
                            }
                        }
                        if block.kind != "quote": VerticalLayout {
                            padding: (block.kind == "code" || block.kind == "table") ? 6px : 0px; spacing: 4px;
                            if block.kind == "code": HorizontalLayout {
                                Text { text: block.label == "" ? "Code" : block.label; color: Theme.text-tertiary; font-size: Theme.micro-size; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Button { label: "Copy"; intent: ButtonIntent.quiet; activated => { root.action("copy-text", block.text); } }
                            }
                            if root.entry.detail != "streaming": Text {
                                text: block.text; color: block.kind == "addition" ? Theme.diff-add-text : (block.kind == "deletion" ? Theme.diff-remove-text : Theme.text);
                                font-size: block.kind == "heading-1" ? Theme.title-one-size : (block.kind == "heading-2" ? Theme.title-two-size : (block.kind == "heading-3" ? Theme.interface-size : (block.kind == "code" || block.kind == "table" || block.kind == "addition" || block.kind == "deletion" ? Theme.code-size : Theme.prose-size)));
                                font-weight: block.kind == "heading-1" || block.kind == "heading-2" || block.kind == "heading-3" ? 600 : 400;
                                font-family: block.kind == "code" || block.kind == "addition" || block.kind == "deletion" || block.kind == "table" ? "monospace" : "sans-serif";
                                wrap: (block.kind == "code" || block.kind == "addition" || block.kind == "deletion" || block.kind == "table") ? no-wrap : word-wrap;
                            }
                            if root.entry.detail == "streaming": StreamingText {
                                text: block.text;
                                font-size: block.kind == "heading-1" ? Theme.title-one-size : (block.kind == "heading-2" ? Theme.title-two-size : (block.kind == "heading-3" ? Theme.interface-size : Theme.prose-size));
                                font-weight: block.kind == "heading-1" || block.kind == "heading-2" || block.kind == "heading-3" ? 600 : 400;
                                font-family: block.kind == "code" || block.kind == "addition" || block.kind == "deletion" || block.kind == "table" ? "monospace" : "sans-serif";
                                wrap: (block.kind == "code" || block.kind == "addition" || block.kind == "deletion" || block.kind == "table") ? no-wrap : word-wrap;
                                active: true;
                            }
                        }
                    }
                }
                if root.entry.tone == "user": HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        label: "Rewind";
                        intent: ButtonIntent.quiet;
                        activated => { root.rewind(); }
                    }
                }
            }
        }
    }
}
