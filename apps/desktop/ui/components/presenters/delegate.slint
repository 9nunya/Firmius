import { Theme } from "../../foundation/theme.slint";
import { ActivityData } from "../../models.slint";
import { OutputViewer } from "../../content/output-viewer.slint";
import { Button, ButtonIntent } from "../../kit/button.slint";
import { ToolIcon } from "../../kit/tool-icon.slint";
import { StateGlyph } from "../../kit/state-glyph.slint";
export component DelegatePresenter inherits Rectangle {
    in property <ActivityData> data;
    in property <bool> expanded;
    callback action(string, string);
    height: content.preferred-height;
    content := VerticalLayout {
        spacing: 8px;
        if root.data.brief != "" && root.data.brief != root.data.intent && root.data.brief != root.data.summary: Text { text: root.data.brief; color: Theme.secondary; font-size: Theme.interface-size; wrap: word-wrap; }
        for agent in root.data.resources: Rectangle {
            height: identity.preferred-height + 16px;
            border-width: 1px; border-color: Theme.border; border-radius: Theme.radius;
            identity := VerticalLayout {
                padding: 8px; spacing: 6px;
                HorizontalLayout {
                    Text { text: agent.label; color: Theme.text; font-size: Theme.interface-size; overflow: elide; horizontal-stretch: 1; }
                    StateGlyph { state: agent.state; failed: agent.failed; }
                }
                Text { text: agent.mode == "spawn" ? "Background agent · parent can continue" : "Awaiting this agent's result"; color: Theme.secondary; font-size: Theme.secondary-size; wrap: word-wrap; }
                Button { label: "Open conversation →"; intent: ButtonIntent.quiet; activated => { root.action("agent", agent.agent); } }
            }
        }
        for child in root.data.children: Rectangle {
            height: child.kind == "bash" && child.output != "" ? 48px : 28px;
            background: Theme.window; border-radius: 4px;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 8px;
                ToolIcon { kind: child.kind; }
                VerticalLayout {
                    alignment: center; spacing: 2px;
                    Text {
                        text: child.kind == "bash" && child.command != "" ? "$ " + child.command :
                              (child.kind == "edit" && child.path != "" ? "Editing " + child.path :
                              (child.kind == "query" && child.query != "" ? "Searching “" + child.query + "”" : child.summary));
                        color: Theme.text; font-size: Theme.secondary-size; overflow: elide; horizontal-alignment: left;
                    }
                    if child.kind == "bash" && child.output != "": Text {
                        text: child.output; color: Theme.secondary; font-family: "monospace";
                        font-size: Theme.secondary-size; overflow: elide; horizontal-alignment: left;
                    }
                }
                StateGlyph { state: child.state; failed: child.state == "Failed" || child.state == "Interrupted"; }
            }
        }
        if root.data.omitted != "": Text { text: root.data.omitted; color: Theme.warning; font-size: Theme.secondary-size; wrap: word-wrap; }
        if root.expanded && root.data.output != "": OutputViewer { text: root.data.output; preserve-columns: false; }
        if root.expanded && root.data.output != "": Button { label: "Open raw result"; intent: ButtonIntent.quiet; activated => { root.action("raw-output", ""); } }
    }
}
