FROM node:20-slim

WORKDIR /work

# Layer 1: System dependencies (rarely changes)
RUN apt-get update && apt-get install -y \
    git curl python3 python3-pip openssh-server bash grep coreutils findutils gawk procps \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && rm -rf /var/lib/apt/lists/*

# Layer 2: LSPs and development tools (changes occasionally)
RUN apt-get update && apt-get install -y clangd \
    && npm install -g typescript-language-server typescript pyright \
    && curl -L https://github.com/rust-lang/rust-analyzer/releases/latest/download/rust-analyzer-x86_64-unknown-linux-gnu.gz | gunzip -c > /usr/local/bin/rust-analyzer \
    && chmod +x /usr/local/bin/rust-analyzer \
    && curl -L https://go.dev/dl/go1.25.0.linux-amd64.tar.gz | tar -C /usr/local -xz \
    && ln -s /usr/local/go/bin/go /usr/local/bin/go \
    && /usr/local/go/bin/go install golang.org/x/tools/gopls@latest \
    && ln -s /root/go/bin/gopls /usr/local/bin/gopls \
    && rm -rf /var/lib/apt/lists/*

# Layer 3: Pre-installed Python packages for SWE-Bench (most common packages)
RUN pip3 install --break-system-packages --no-cache-dir \
    pytz sqlparse asgiref pytest mock requests \
    numpy pandas setuptools wheel django \
    && rm -rf /root/.cache/pip

# Layer 4: Pre-installed Node.js packages for SWE-Bench
RUN npm install -g jest mocha chai sinon nyc \
    && npm cache clean --force

# Configure SSH for testing
RUN mkdir /var/run/sshd && \
    useradd -m -s /bin/bash testuser && \
    echo "testuser:testpassword" | chpasswd && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config

# Default to a non-root user (optional but recommended)
# RUN useradd -m firmius && chown -R firmius /work
# USER firmius

CMD ["/usr/sbin/sshd", "-D"]
